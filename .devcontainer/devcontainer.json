{
  "name": "Go + Nix",
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "features": {
    "ghcr.io/devcontainers/features/nix:1": {
      "extraNixConfig": "experimental-features = nix-command flakes",
      "packages": "direnv"
    }
  },
  "onCreateCommand": "echo 'eval \"$(direnv hook bash)\"' >> ~/.bashrc && direnv allow && nix develop --command true",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "mkhl.direnv", "jnoortheen.nix-ide"],
      "settings": { "go.toolsManagement.checkForUpdates": "off" }
    }
  }
}
